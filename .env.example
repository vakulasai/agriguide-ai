# AgriGuide AI Environment Configuration

# Database: SQLite local file (default) or PostgreSQL (e.g. postgresql://user:password@localhost:5432/agriguide?schema=public)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration (Options: openai | anthropic | gemini | mock)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-pro"

# Authentication Secret (Used for session tokens)
AUTH_SECRET="agri-guide-secret-jwt-key-2025"

# Weather Provider Configuration (Open-Meteo is default and requires NO key!)
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""

# Market Intelligence Provider (Agmarknet / NCPB / Demo adapter)
MARKET_DATA_PROVIDER="national-agri"
MARKET_DATA_API_KEY=""

# Application Port and Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
